# Másold át: cp .env.example .env
# A .env fájlt NE commitold (lásd .gitignore)

# OpenAI API kulcs – csak a szerveren!
OPENAI_API_KEY=sk-ide-ird-be-a-kulcsodat

# Opcionális modell (alapértelmezett: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Frontend: hol érhető el a backend (production URL deploy után)
# VILMOS_API_BASE=https://your-project.vercel.app
